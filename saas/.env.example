# ============================================================
# X → LinkedIn SaaS — Variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# ============================================================

# --- Base de datos ---
# SQLite para desarrollo local; Railway añade PostgreSQL automáticamente en prod.
DATABASE_URL=sqlite+aiosqlite:///./saas.db

# --- Seguridad JWT ---
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 días

# --- Anthropic (genera posts con IA) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Stripe (pagos — plan Pro a $10/mes) ---
# https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Crea un Price en Stripe con $10/mes y pega el ID aquí
STRIPE_PRICE_ID_PRO=price_...

# --- Bot de Telegram ---
# 1. Habla con @BotFather → /newbot
# 2. Copia el token aquí
# 3. Pon el username del bot (sin @)
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_BOT_USERNAME=mi_bot_username

# --- App ---
# URL pública de la app (usada en links del bot y redirects de Stripe)
APP_URL=http://localhost:8001
# "production" activa el webhook de Telegram en lugar de polling
ENVIRONMENT=development
