# Text generation provider
TEXT_GENERATION_PROVIDER=anthropic

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-opus-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=minimal

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
LINKEDIN_API_VERSION=202605
LINKEDIN_READ_SCOPE_ENABLED=false

# LinkedIn session cookies for metrics scraping (optional)
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Google AI image generation (optional)
GOOGLE_API_KEY=

# App
SECRET_KEY=dev-secret-key-change-in-production
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./x_to_linkedin.db
SCHEDULER_DATABASE_URL=sqlite:///./scheduler_jobs.db
ALLOW_INSECURE_SSL_FALLBACK=false
POST_LANGUAGE=es
PRE_PUBLISH_VERIFICATION_ENABLED=true
PRE_PUBLISH_VERIFICATION_HOURS=6
LINKEDIN_COMMENT_CHECK_INTERVAL_MINUTES=20
LINKEDIN_COMMENT_MONITOR_DAYS=90

# Editorial radar
# Creates daily empty slots, searches fresh sources 48h before publishing,
# sends Telegram approval 60 min before publishing, and publishes only if approved.
EDITORIAL_RADAR_ENABLED=true
EDITORIAL_RADAR_LEAD_HOURS=48
EDITORIAL_RADAR_APPROVAL_LEAD_MINUTES=60
EDITORIAL_RADAR_PUBLISH_DELAY_MINUTES=30
EDITORIAL_RADAR_DAYS_AHEAD=14
EDITORIAL_RADAR_SOURCE_MAX_AGE_HOURS=168

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=0

# X likes monitor via browser session cookies (optional)
X_USERNAME=
X_AUTH_TOKEN=
X_CT0=
X_USER_ID=
X_AUTO_SCHEDULE_ENABLED=false
X_CHECK_INTERVAL_MINUTES=15
X_MONITOR_START_DATE=

# Cloud only. Keep effect switches off until cutover.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_USER_ID=
APP_ORIGIN=
APP_ENV=preview
CREDENTIAL_ENCRYPTION_KEY=
TELEGRAM_WEBHOOK_SECRET=
DISPATCH_SECRET=
WORKER_SECRET=
PUBLISHING_ENABLED=false
TELEGRAM_SEND_ENABLED=false
RADAR_ENABLED=false
NONCRITICAL_JOBS_ENABLED=false
MIGRATION_FREEZE=true
