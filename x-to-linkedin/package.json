{
  "name": "x-to-linkedin-cloud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node cloud/scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "netlify dev --cwd ..",
    "cloud:export": "python scripts/cloud/export_sqlite.py",
    "cloud:import": "tsx scripts/cloud/import_snapshot.ts",
    "cloud:reconcile": "tsx scripts/cloud/reconcile_snapshot.ts",
    "cloud:rollback-export": "tsx scripts/cloud/export_cloud_rollback.ts",
    "cloud:shadow": "tsx scripts/cloud/run_shadow_cycle.ts",
    "cloud:configure": "tsx scripts/cloud/configure_cloud.ts",
    "cloud:telegram:on": "tsx scripts/cloud/configure_telegram.ts",
    "cloud:telegram:off": "tsx scripts/cloud/rollback_telegram.ts"
  },
  "dependencies": {
    "@netlify/edge-functions": "3.0.8",
    "@netlify/functions": "5.3.0",
    "@supabase/supabase-js": "2.110.8",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.10.1",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "netlify-cli": "27.0.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
