# ─────────────────────────────────────────────
# MODO DEMO (sin API keys, datos mock)
# ─────────────────────────────────────────────
# Pon "true" para probar sin configurar nada más
DEMO_MODE=false

# ─────────────────────────────────────────────
# OBLIGATORIAS para que la app funcione
# ─────────────────────────────────────────────

# 1. Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# 2. Supabase — https://supabase.com → New project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─────────────────────────────────────────────
# OPCIONALES (mejoran el discovery de herramientas)
# ─────────────────────────────────────────────

# 3. Google Custom Search — https://developers.google.com/custom-search
#    Crea un Search Engine en https://programmablesearchengine.google.com
GOOGLE_SEARCH_API_KEY=AIza...
GOOGLE_SEARCH_ENGINE_ID=...

# 4. ElevenLabs (micro-videos con voz) — https://elevenlabs.io
ELEVENLABS_API_KEY=...

# ─────────────────────────────────────────────
# CÓMO CONFIGURAR EN VERCEL
# ─────────────────────────────────────────────
# Dashboard → tu proyecto → Settings → Environment Variables
# Pega cada variable una por una (las NEXT_PUBLIC_ son visibles en el browser)
