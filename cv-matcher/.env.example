# ── REQUIRED ──────────────────────────────────────────────────
# Your Anthropic API key (get it at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# ── SUPABASE (needed for auth & production DB) ─────────────────
# Found in: Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── TELEGRAM BOT (optional) ────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── STRIPE (needed for payments) ───────────────────────────────
# Found in: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Found in: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Found in: Stripe Dashboard → Products → (your product) → Price ID
STRIPE_PRICE_CREDITS=price_...
STRIPE_PRICE_MONTHLY=price_...

# ── APP CONFIG ─────────────────────────────────────────────────
# The public URL of your deployed app (no trailing slash)
APP_URL=https://your-app.up.railway.app

# Number of free CV generations per user before paywall
FREE_GENERATIONS_LIMIT=3

# Number of credits included in the one-time credit pack
CREDITS_PER_PACK=10

# Price labels shown in the paywall UI (display only, not used for billing)
PRICE_CREDITS_DISPLAY=$9
PRICE_MONTHLY_DISPLAY=$19/mo
